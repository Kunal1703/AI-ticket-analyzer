# --------------------------------------------------
# AI Ticket Analyzer — Environment Variables
# --------------------------------------------------
# Copy this file to .env and fill in your values.

# --------------------------------------------------
# AI provider (provider-agnostic)
# --------------------------------------------------
# Select the backend. Supported: openai, groq, together, openrouter, ollama,
# openai-compatible. Each uses the generic LLM_* settings below.
# AI_PROVIDER=openai

# API key/token for the selected provider. Optional for keyless providers
# (e.g. ollama). OPENAI_API_KEY is accepted as a backward-compatible alias.
# LLM_API_KEY=sk-your-api-key-here

# Model identifier (defaults to a per-provider value when unset).
# LLM_MODEL=gpt-4o-2024-08-06

# API base URL. Optional — a per-provider default is used when unset.
# Required only for AI_PROVIDER=openai-compatible.
# LLM_BASE_URL=

# Request timeout in seconds (default: 30) and max attempts (default: 3).
# LLM_TIMEOUT=30
# LLM_MAX_RETRIES=3
# LLM_TEMPERATURE=0.2
# Prompt version to use (see app/prompts.py). Unset uses the default (v1).
# Recorded on each analysis (analyses.prompt_version) for eval/traceability (M5.1).
# LLM_PROMPT_VERSION=v1

# --- Provider examples ---
# OpenAI:        AI_PROVIDER=openai      LLM_API_KEY=sk-...
# Groq:          AI_PROVIDER=groq        LLM_API_KEY=gsk-...   LLM_MODEL=llama-3.1-70b-versatile
# OpenRouter:    AI_PROVIDER=openrouter  LLM_API_KEY=sk-or-... LLM_MODEL=openai/gpt-4o
# Together:      AI_PROVIDER=together    LLM_API_KEY=...       LLM_MODEL=meta-llama/Llama-3.1-70B-Instruct-Turbo
# Ollama (local, no key): AI_PROVIDER=ollama  LLM_MODEL=llama3.1
# Custom OpenAI-compatible: AI_PROVIDER=openai-compatible  LLM_BASE_URL=https://host/v1  LLM_MODEL=...

# Optional: Cache TTL in seconds; 0 disables caching (default: 300)
# CACHE_TTL_SECONDS=300

# Optional: Log level, used when DEBUG=false (default: INFO)
# LOG_LEVEL=INFO

# Optional: Log format — "json" (structured, default) or "text" (human-readable)
# LOG_FORMAT=json

# Optional: Debug mode — forces DEBUG logging (default: false)
# DEBUG=false

# Optional: CORS allowed origins as a JSON array
# (default: common localhost dev origins). Set explicitly in production.
# CORS_ALLOW_ORIGINS=["https://app.example.com"]

# Optional: Allow credentialed CORS requests (cookies/Authorization).
# Must NOT be combined with a wildcard origin (default: false)
# CORS_ALLOW_CREDENTIALS=false

# Optional: Database URL for persistence (the app runs without it).
# Used by the app and by Alembic migrations. Use the psycopg driver:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/ticket_analyzer

# Optional: Redis URL for a shared cache. When unset, an in-memory cache is used.
REDIS_URL=redis://localhost:6379/0

# Auth (optional): set JWT_SECRET to enable authentication endpoints.
# Auth also requires DATABASE_URL (users are persisted).
# JWT_SECRET=change-me-to-a-long-random-string
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=1209600
